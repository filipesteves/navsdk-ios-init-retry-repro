// Copy to Secrets.xcconfig (gitignored) and fill in.
// The key's project needs the Navigation SDK enabled. If the key is restricted to iOS
// bundle IDs, add REPRO_BUNDLE_ID to its allowed list, or the init request fails for a
// different reason.
GMS_API_KEY = your-ios-key-here
REPRO_BUNDLE_ID = com.example.navsdkretryrepro
DEVELOPMENT_TEAM = YOURTEAMID
